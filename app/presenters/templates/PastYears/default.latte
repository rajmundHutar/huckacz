{block title}Minulé ročníky{/block}

{block content}
<h1 class="page-title">Minulé ročníky</h1>
<p class="page-lead">Divadelní festival pro děti a mládež, Třebíč 1999–2017</p>

<div class="years">
    <a n:foreach="$years as $y" n:tag="$y['count'] ? a : div" class="year-card"
       n:attr="href => $y['count'] ? $presenter->link('Gallery:default', ['year' => $y['year']]) : null">
        {if $y['cover']}
            <div n:class="year-cover, $y['year'] === 2017 ? year-cover-poster" style="background-image: url('{$basePath}{$y['cover']}')"></div>
        {else}
            <div class="year-cover year-cover-empty">{$y['year']}</div>
        {/if}
        <div class="year-body">
            <div class="year-name">{$y['title'] ?: "Hučka {$y['year']}"}</div>
            <div class="year-theme">{if $y['title']}Hučka {$y['year']}{/if}</div>
            {if $y['count']}
                <div class="year-meta">Fotogalerie · {$y['count']} fotek →</div>
            {else}
                <div class="year-meta year-meta-none">Bez fotogalerie</div>
            {/if}
        </div>
    </a>
</div>
{/block}
