{block title}Hučka {$gallery['year']}{/block}

{block content}
<div class="gallery-head">
    <div>
        <h1 class="page-title">Hučka {$gallery['year']} <small>{$gallery['title']}</small></h1>
        <p class="page-lead">{$gallery['count']} fotek</p>
    </div>
    <div class="year-nav">
        {if $gallery['older']}<a n:href="this year => $gallery['older']">‹ {$gallery['older']}</a>{else}<span>‹</span>{/if}
        {if $gallery['newer']}<a n:href="this year => $gallery['newer']">{$gallery['newer']} ›</a>{else}<span>›</span>{/if}
    </div>
</div>

<div class="year-chips">
    <a n:foreach="array_reverse($galleries, true) as $id => $gall" n:href="this year => $id" n:class="$id === $gallery['year'] ? active">{$id}</a>
</div>

<div class="photos">
    <a n:foreach="$gallery['images'] as $image" href="{$basePath}{$image['image']}" data-lightbox="gallery">
        <img src="{$basePath}{$image['thumbnail']}" loading="lazy" alt="">
    </a>
</div>
{/block}
